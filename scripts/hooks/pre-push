#!/usr/bin/env bash
# pre-push — run the full project gate before anything leaves this machine.
#
# This replaces what used to be a GitHub Actions workflow: the same stages, in
# the same order, run locally instead. A non-zero exit here aborts the push
# without sending anything (githooks(5): "If this hook exits with a non-zero
# status, git push will abort without pushing anything").
#
# The gate itself (all eleven stages, the preflight checks, and the fmt/markdown
# helpers) lives in scripts/gate.sh, so CI and the release workflow can run
# the same stages without copying them into a second file that would drift
# from this one. This hook only handles what is genuinely hook-specific: the
# stdin ref parsing and the "nothing to verify" early exit, then delegates.
#
# Install once per clone:
#   git config core.hooksPath scripts/hooks
#
# Bypass deliberately with:
#   git push --no-verify
#
# Arguments: $1 = remote name, $2 = remote URL (equal when pushing to a URL).
# Stdin: one line per ref, "<local-ref> <local-oid> <remote-ref> <remote-oid>".
set -euo pipefail

remote_name="${1:-}"

# --- Early exit: nothing to verify ------------------------------------------
# A deletion is signalled by an all-zero <local-oid>. If every line is a
# deletion (or stdin is empty, as with `git push` on an up-to-date branch),
# there is no new code to gate.
has_work=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [[ -z "$local_oid" ]] && continue
  if ! [[ "$local_oid" =~ ^0+$ ]]; then
    has_work=1
  fi
done

if [[ "$has_work" -eq 0 ]]; then
  echo "pre-push: nothing to verify (no new commits${remote_name:+ for $remote_name}); skipping gate."
  exit 0
fi

# --- Delegate to the gate ----------------------------------------------------
# `--show-toplevel` is correct under `git worktree`, unlike deriving paths from
# $GIT_DIR (which points at the shared common dir's per-worktree subdirectory).
#
# Caveat worth knowing: this checks the WORKING TREE as it currently sits, not
# the commits being pushed. A dirty tree is what gets tested.
exec bash "$(git rev-parse --show-toplevel)/scripts/gate.sh"
