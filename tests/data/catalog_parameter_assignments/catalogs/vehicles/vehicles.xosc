<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="3" date="2024-01-01T00:00:00" description="Vehicle entries whose parameters a CatalogReference assigns" author="openscenario-rs"/>
  <Catalog name="Vehicles">
    <Vehicle name="sedan" vehicleCategory="car" mass="$mass">
      <ParameterDeclarations>
        <ParameterDeclaration name="top_speed" parameterType="double" value="30"/>
        <ParameterDeclaration name="mass" parameterType="double" value="1500"/>
        <ParameterDeclaration name="half_speed" parameterType="double" value="${$top_speed / 2}"/>
      </ParameterDeclarations>
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="$top_speed" maxAcceleration="$half_speed" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
    </Vehicle>
    <Vehicle name="leaky" vehicleCategory="car">
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="$document_speed" maxAcceleration="5" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
    </Vehicle>
    <Vehicle name="towing" vehicleCategory="car">
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="40" maxAcceleration="5" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
      <Trailer>
        <Trailer name="towed">
          <CatalogReference catalogName="Vehicles" entryName="towing"/>
        </Trailer>
      </Trailer>
    </Vehicle>
    <Vehicle name="tractor" vehicleCategory="semitrailer">
      <ParameterDeclarations>
        <ParameterDeclaration name="trailer_speed" parameterType="double" value="20"/>
      </ParameterDeclarations>
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="25" maxAcceleration="5" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
      <Trailer>
        <Trailer name="load">
          <CatalogReference catalogName="Vehicles" entryName="sedan">
            <ParameterAssignments>
              <ParameterAssignment parameterRef="top_speed" value="$trailer_speed"/>
            </ParameterAssignments>
          </CatalogReference>
        </Trailer>
      </Trailer>
    </Vehicle>
    <Vehicle name="plain" vehicleCategory="car">
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="45" maxAcceleration="5" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
    </Vehicle>
    <Vehicle name="twin" vehicleCategory="car">
      <BoundingBox>
        <Center x="1.4" y="0" z="0.75"/>
        <Dimensions width="2" length="4.5" height="1.5"/>
      </BoundingBox>
      <Performance maxSpeed="35" maxAcceleration="5" maxDeceleration="10"/>
      <Axles>
        <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3"/>
        <RearAxle maxSteering="0" wheelDiameter="0.6" trackWidth="1.8" positionX="0" positionZ="0.3"/>
      </Axles>
    </Vehicle>
  </Catalog>
</OpenSCENARIO>
